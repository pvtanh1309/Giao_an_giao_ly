{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDevState",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::gxthaian-giaoan-web-2026",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "giaoan-web/dev/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadWriteDevState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::gxthaian-giaoan-web-2026/giaoan-web/dev/terraform.tfstate"
    },
    {
      "Sid": "DevStateLock",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::gxthaian-giaoan-web-2026/giaoan-web/dev/terraform.tfstate.tflock"
    },
    {
      "Sid": "ManageDevAppBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketTagging",
        "s3:PutBucketTagging",
        "s3:GetBucketPolicy",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetBucketOwnershipControls",
        "s3:PutBucketOwnershipControls",
        "s3:GetBucketVersioning",
        "s3:PutBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:GetBucketCORS",
        "s3:PutBucketCORS",
        "s3:GetBucketAcl",
        "s3:GetBucketWebsite",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketLogging",
        "s3:GetBucketObjectLockConfiguration"
      ],
      "Resource": "arn:aws:s3:::giaoan-dev-app-030540333236"
    },
    {
      "Sid": "UploadFrontendOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::giaoan-dev-app-030540333236/frontend/*"
    },
    {
      "Sid": "ManageDevDatabase",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DeleteTable",
        "dynamodb:DescribeTable",
        "dynamodb:UpdateTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:UpdateTimeToLive",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:ListTagsOfResource",
        "dynamodb:TagResource",
        "dynamodb:UntagResource"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-1:030540333236:table/giaoan-dev"
    },
    {
      "Sid": "ManageDevExecutionRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:UpdateRole",
        "iam:DeleteRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:GetRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags"
      ],
      "Resource": [
        "arn:aws:iam::030540333236:role/giaoan-dev-content-api",
        "arn:aws:iam::030540333236:role/giaoan-dev-lessons-api",
        "arn:aws:iam::030540333236:role/giaoan-dev-catalog-api",
        "arn:aws:iam::030540333236:role/giaoan-dev-users-api"
      ]
    },
    {
      "Sid": "PassDevRolesToLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::030540333236:role/giaoan-dev-content-api",
        "arn:aws:iam::030540333236:role/giaoan-dev-lessons-api",
        "arn:aws:iam::030540333236:role/giaoan-dev-catalog-api",
        "arn:aws:iam::030540333236:role/giaoan-dev-users-api"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ManageDevLambdaFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:DeleteFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:GetPolicy",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:ListVersionsByFunction",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:ListTags",
        "lambda:TagResource",
        "lambda:UntagResource"
      ],
      "Resource": [
        "arn:aws:lambda:ap-southeast-1:030540333236:function:giaoan-dev-content-api",
        "arn:aws:lambda:ap-southeast-1:030540333236:function:giaoan-dev-lessons-api",
        "arn:aws:lambda:ap-southeast-1:030540333236:function:giaoan-dev-catalog-api",
        "arn:aws:lambda:ap-southeast-1:030540333236:function:giaoan-dev-users-api"
      ]
    },
    {
      "Sid": "WriteDevStreamMappings",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateEventSourceMapping",
        "lambda:UpdateEventSourceMapping",
        "lambda:DeleteEventSourceMapping"
      ],
      "Resource": "*",
      "Condition": {
        "ArnEquals": {
          "lambda:FunctionArn": [
            "arn:aws:lambda:ap-southeast-1:030540333236:function:giaoan-dev-content-api",
            "arn:aws:lambda:ap-southeast-1:030540333236:function:giaoan-dev-lessons-api",
            "arn:aws:lambda:ap-southeast-1:030540333236:function:giaoan-dev-users-api"
          ]
        }
      }
    },
    {
      "Sid": "ReadStreamMappings",
      "Effect": "Allow",
      "Action": [
        "lambda:GetEventSourceMapping",
        "lambda:ListEventSourceMappings",
        "lambda:ListTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Sid": "ManageDevLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:ListTagsLogGroup",
        "logs:TagLogGroup",
        "logs:UntagLogGroup",
        "logs:ListTagsForResource",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": [
        "arn:aws:logs:ap-southeast-1:030540333236:log-group:/aws/lambda/giaoan-dev-*",
        "arn:aws:logs:ap-southeast-1:030540333236:log-group:/aws/lambda/giaoan-dev-*:*",
        "arn:aws:logs:ap-southeast-1:030540333236:log-group:/aws/apigateway/giaoan-dev-*",
        "arn:aws:logs:ap-southeast-1:030540333236:log-group:/aws/apigateway/giaoan-dev-*:*"
      ]
    },
    {
      "Sid": "ReadRegionalMetadata",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "cloudwatch:DescribeAlarms"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Sid": "ManageDevAlarms",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:ListTagsForResource",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource"
      ],
      "Resource": "arn:aws:cloudwatch:ap-southeast-1:030540333236:alarm:giaoan-dev-*"
    },
    {
      "Sid": "ManageDevFailureQueues",
      "Effect": "Allow",
      "Action": [
        "sqs:CreateQueue",
        "sqs:DeleteQueue",
        "sqs:GetQueueUrl",
        "sqs:GetQueueAttributes",
        "sqs:SetQueueAttributes",
        "sqs:ListQueueTags",
        "sqs:TagQueue",
        "sqs:UntagQueue"
      ],
      "Resource": "arn:aws:sqs:ap-southeast-1:030540333236:giaoan-dev-*-api-stream-failures"
    },
    {
      "Sid": "ManageDevAlarmTopic",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:ListTagsForResource",
        "sns:TagResource",
        "sns:UntagResource"
      ],
      "Resource": "arn:aws:sns:ap-southeast-1:030540333236:giaoan-dev-alarms"
    },
    {
      "Sid": "CreateTaggedDevUserPool",
      "Effect": "Allow",
      "Action": "cognito-idp:CreateUserPool",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Project": "giaoan",
          "aws:RequestedRegion": "ap-southeast-1"
        }
      }
    },
    {
      "Sid": "ManageTaggedDevIdentity",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:DescribeUserPool",
        "cognito-idp:UpdateUserPool",
        "cognito-idp:DeleteUserPool",
        "cognito-idp:CreateUserPoolClient",
        "cognito-idp:DescribeUserPoolClient",
        "cognito-idp:UpdateUserPoolClient",
        "cognito-idp:DeleteUserPoolClient",
        "cognito-idp:CreateGroup",
        "cognito-idp:GetGroup",
        "cognito-idp:UpdateGroup",
        "cognito-idp:DeleteGroup",
        "cognito-idp:ListTagsForResource",
        "cognito-idp:TagResource",
        "cognito-idp:UntagResource",
        "cognito-idp:GetUserPoolMfaConfig",
        "cognito-idp:SetUserPoolMfaConfig"
      ],
      "Resource": "arn:aws:cognito-idp:ap-southeast-1:030540333236:userpool/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "dev",
          "aws:ResourceTag/Project": "giaoan"
        }
      }
    },
    {
      "Sid": "BootstrapHttpApis",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:PATCH",
        "apigateway:DELETE"
      ],
      "Resource": [
        "arn:aws:apigateway:ap-southeast-1::/apis",
        "arn:aws:apigateway:ap-southeast-1::/apis/*",
        "arn:aws:apigateway:ap-southeast-1::/tags/*"
      ]
    },
    {
      "Sid": "CreateDevDistribution",
      "Effect": "Allow",
      "Action": "cloudfront:CreateDistribution",
      "Resource": "arn:aws:cloudfront::030540333236:distribution/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Project": "giaoan"
        }
      }
    },
    {
      "Sid": "ManageTaggedDevDistribution",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:UpdateDistribution",
        "cloudfront:DeleteDistribution",
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation",
        "cloudfront:ListTagsForResource",
        "cloudfront:TagResource",
        "cloudfront:UntagResource"
      ],
      "Resource": "arn:aws:cloudfront::030540333236:distribution/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Environment": "dev",
          "aws:ResourceTag/Project": "giaoan"
        }
      }
    },
    {
      "Sid": "TagNewDevDistribution",
      "Effect": "Allow",
      "Action": "cloudfront:TagResource",
      "Resource": "arn:aws:cloudfront::030540333236:distribution/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Environment": "dev",
          "aws:RequestTag/Project": "giaoan"
        }
      }
    },
    {
      "Sid": "ManageDevRoutingFunction",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateFunction",
        "cloudfront:DescribeFunction",
        "cloudfront:GetFunction",
        "cloudfront:UpdateFunction",
        "cloudfront:PublishFunction",
        "cloudfront:DeleteFunction",
        "cloudfront:ListTagsForResource",
        "cloudfront:TagResource",
        "cloudfront:UntagResource"
      ],
      "Resource": "arn:aws:cloudfront::030540333236:function/giaoan-dev-routes"
    },
    {
      "Sid": "BootstrapOriginAccessControls",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateOriginAccessControl",
        "cloudfront:GetOriginAccessControl",
        "cloudfront:GetOriginAccessControlConfig",
        "cloudfront:UpdateOriginAccessControl",
        "cloudfront:DeleteOriginAccessControl"
      ],
      "Resource": "*"
    }
  ]
}
